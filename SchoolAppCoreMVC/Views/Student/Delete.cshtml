@model SchoolAppCoreMVC.Models.Student
@{ ViewData["Title"] = "Delete Student"; }
<h1>Delete Student</h1>
<h3>Are you sure you want to delete this student?</h3>
<dl class="row"><dt class="col-sm-3">Name</dt><dd class="col-sm-9">@Model.FirstName @Model.LastName</dd><dt class="col-sm-3">Enrollment date</dt><dd class="col-sm-9">@Model.EnrollmentDate.ToShortDateString()</dd></dl>
<form asp-action="Delete"><input type="hidden" asp-for="StudentID" /><button type="submit" class="btn btn-danger">Delete</button> <a asp-action="Index">Back to List</a></form>
