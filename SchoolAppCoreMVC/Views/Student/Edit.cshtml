@model SchoolAppCoreMVC.Models.Student
@{ ViewData["Title"] = "Edit Student"; }
<h1>Edit Student</h1>
<form asp-action="Edit">
	<div asp-validation-summary="ModelOnly" class="text-danger"></div>
	<input type="hidden" asp-for="StudentID" />
	<div class="mb-3"><label asp-for="FirstName" class="form-label"></label><input asp-for="FirstName" class="form-control" /><span asp-validation-for="FirstName" class="text-danger"></span></div>
	<div class="mb-3"><label asp-for="LastName" class="form-label"></label><input asp-for="LastName" class="form-control" /><span asp-validation-for="LastName" class="text-danger"></span></div>
	<div class="mb-3"><label asp-for="EnrollmentDate" class="form-label"></label><input asp-for="EnrollmentDate" class="form-control" /><span asp-validation-for="EnrollmentDate" class="text-danger"></span></div>
	<button type="submit" class="btn btn-primary">Save</button> <a asp-action="Index">Back to List</a>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
